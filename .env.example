# Copy to .env in the project root and replace every placeholder.
# MongoDB must be a replica set because sales and stock writes use transactions.
MONGODB_URI=mongodb://127.0.0.1:27017/northstar?replicaSet=rs0
JWT_SECRET=replace-with-a-long-random-secret
PORT=5000
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Optional development seed accounts. Set unique passwords before running the seed command.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-this-password
SEED_STAFF_EMAIL=staff@example.com
SEED_STAFF_PASSWORD=replace-this-password
